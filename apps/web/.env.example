# Leave NEXT_PUBLIC_API_URL empty: browser calls /api on same origin and Next proxies to apps/api.
NEXT_PUBLIC_API_URL=
API_PROXY_TARGET=http://127.0.0.1:4001

# Firebase web config (public by design; match FIREBASE_PROJECT_ID in apps/api/.env)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
